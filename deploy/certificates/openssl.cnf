[req]
default_bits       = 2048
prompt             = no
default_md         = sha256
x509_extensions    = v3_req
distinguished_name = dn

[dn]
C  = JP
ST = Tokyo
L  = Tokyo
O  = ProxyConsole Dev
OU = DEV-001
CN = app-a.local.test

[v3_req]
subjectAltName = @alt_names
basicConstraints = CA:FALSE
keyUsage = digitalSignature, keyEncipherment
extendedKeyUsage = serverAuth

[alt_names]
DNS.1 = app-a.local.test
DNS.2 = app-b.local.test
DNS.3 = *.local.test
DNS.4 = localhost
IP.1  = 127.0.0.1
