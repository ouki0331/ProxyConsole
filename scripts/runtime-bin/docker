#!/usr/bin/env bash
set -euo pipefail

if [[ -z "${PROXYCONSOLE_RUNTIME_READY:-}" || -z "${CONTAINER_ENGINE_BIN:-}" ]]; then
  echo "[runtime] Runtime shim was called without sourcing scripts/container-runtime.sh." >&2
  exit 127
fi

if [[ "${1:-}" == "compose" ]]; then
  shift

  # podman-compose 1.5.0 rejects Docker Compose's build-only --quiet flag.
  # Keep Docker arguments unchanged, but omit that optional output flag for
  # Podman providers so the shared local CI entrypoint remains portable.
  compose_args=("$@")
  if [[ "${CONTAINER_COMPOSE_PROVIDER:-}" == podman-compose-* ]]; then
    has_profile_arg=0
    for arg in "${compose_args[@]}"; do
      if [[ "${arg}" == "--profile" || "${arg}" == --profile=* ]]; then
        has_profile_arg=1
        break
      fi
    done
    if [[ ${has_profile_arg} -eq 0 && -n "${COMPOSE_PROFILES:-}" ]]; then
      profile_args=()
      IFS=',' read -r -a requested_profiles <<<"${COMPOSE_PROFILES}"
      for profile in "${requested_profiles[@]}"; do
        if [[ -n "${profile}" ]]; then
          profile_args+=(--profile "${profile}")
        fi
      done
      compose_args=("${profile_args[@]}" "${compose_args[@]}")
    fi

    compose_command=""
    for arg in "${compose_args[@]}"; do
      if [[ "${arg}" == "build" ]]; then
        compose_command="build"
        break
      fi
    done
    if [[ "${compose_command}" == "build" ]]; then
      filtered_args=()
      for arg in "${compose_args[@]}"; do
        if [[ "${arg}" != "--quiet" ]]; then
          filtered_args+=("${arg}")
        fi
      done
      compose_args=("${filtered_args[@]}")
    fi
  fi

  case "${CONTAINER_COMPOSE_PROVIDER:-}" in
    podman-compose-binary)
      exec "${CONTAINER_COMPOSE_BIN}" "${compose_args[@]}"
      ;;
    podman-compose-subcommand|docker-compose-plugin)
      exec "${CONTAINER_ENGINE_BIN}" compose "${compose_args[@]}"
      ;;
    *)
      echo "[runtime] Unknown Compose provider: ${CONTAINER_COMPOSE_PROVIDER:-unset}" >&2
      exit 127
      ;;
  esac
fi

exec "${CONTAINER_ENGINE_BIN}" "$@"
